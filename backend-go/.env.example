# Server Configuration
NODE_ENV=development
PORT=3001

# Database URLs
DATABASE_URL=postgresql://streak_user:streak_password@postgres:5432/streak
REDIS_URL=redis://redis:6379
MONGODB_URL=mongodb://streak_admin:streak_password@mongodb:27017/streak_chat?authSource=admin

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-long-and-random
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-must-be-long-and-random
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# RTMP Server
RTMP_SERVER_URL=rtmp://streaming:1935/live

# CORS
CORS_ORIGIN=http://localhost:3000

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300
