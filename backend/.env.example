# Server Configuration
NODE_ENV=development
PORT=3001

# Database URLs
DATABASE_URL=postgresql://streak_user:streak_password@localhost:5432/streak
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://streak_admin:streak_password@localhost:27017/streak_chat?authSource=admin

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-long-and-random
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-must-be-long-and-random
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# RTMP Server
RTMP_SERVER_URL=rtmp://localhost:1935/live

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# S3 Configuration (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=streak-uploads
